      '聊歌就聊歌本身：编曲、嗓音、为什么想翻。别编自己的生活细节（在听谁的歌、昨天干了什么、吃过什么）。',
      '别编现实经历：学校、专业、具体住哪、家里人不讲，一句「这个不讲」带过去。天气、新闻、价格这类当下的事，群里没人提过就说不清楚。',
      '备忘只是背景，别主动翻旧账、别拿它当话题。',
    ].join('\n')
  }

  function groupSystemPrompt(groupId) {
    const custom = String(groupCfg.systemPrompt || '').trim()
    if (custom) return custom
    const parts = [groupPersona()]
    const facts = (groupCfg.facts || []).map((v) => String(v || '').trim()).filter(Boolean)
    if (facts.length) parts.push(`\n已知：${facts.join('；')}。`)
    const memory = groupMemory.get(String(groupId))
    if (memory?.summary) parts.push(`\n之前聊到的：${memory.summary}`)
    parts.push('\n只输出你要说的话：不加名字前缀，不解释，不写括号动作，不换行。')
    return parts.join('')
  }

  /** Fold the recent tail into one short line so context survives truncation. */
  async function summarizeGroup(groupId) {
    const list = groupHistory.get(String(groupId)) || []
    if (list.length < 4) return
    const previous = groupMemory.get(String(groupId))?.summary || ''
    const transcript = list
      .map((m) => `${m.role === 'assistant' ? '你' : '对方'}: ${m.content}`)
      .join('\n')
    const messages = [
      {
        role: 'system',
        content:
          '把下面这段群聊压缩成一句中文备忘，30 字以内。只写还在继续的话题、或者刚定下的事。不要评价，不要写谁在骂人、谁什么态度，不要引号，不要换行。',
      },
      {
        role: 'user',
        content: `${previous ? `旧的备忘：${previous}\n` : ''}${transcript}`,
      },
    ]
    try {
      const raw = await askGroupModel(messages, { maxTokens: 80, temperature: 0.3 })
      const summary = raw.replace(/\s+/g, ' ').replace(/^["「『]|["」』]$/g, '').trim().slice(0, 80)
      if (!summary) return
      groupMemory.set(String(groupId), { summary, updatedAt: Date.now() })
      saveGroupMemorySoon()
      log.info?.(`qq: [群 ${groupId}] 备忘：${summary}`)
    } catch (error) {
      log.warn?.(
        `qq: [群 ${groupId}] 压缩上下文失败：${error instanceof Error ? error.message : String(error)}`,
      )
    }
  }

  function pushGroupHistory(groupId, role, content) {
    if (!groupHistory.has(groupId)) groupHistory.set(groupId, [])
    const list = groupHistory.get(groupId)
    list.push({ role, content })
    const keep = Math.max(2, Number(groupCfg.history) || DEFAULTS.group.history) * 2
    while (list.length > keep) list.shift()
  }

  const groupLogFile = path.join(cfg.dataDir || DEFAULTS.dataDir, 'group.log')

  /** Group traffic gets its own plain-text trace: the host log is invisible. */
  async function groupTrace(line) {
    try {
      await appendFile(groupLogFile, `${new Date().toISOString()} ${line}\n`, 'utf8')
    } catch {
      /* trace must never break the bridge */
    }
  }

  /** Send one short line into a group (used for asides, not model replies). */
  async function groupSay(groupId, body) {
    try {
      await callApi('send_group_msg', {
        group_id: /^\d+$/.test(groupId) ? Number(groupId) : groupId,
        message: body,
      })
      return true
    } catch (error) {
      log.warn?.(
        `qq: [群 ${groupId}] 发不出去：${error instanceof Error ? error.message : String(error)}`,
      )
      return false
    }
  }

  async function handleGroupEvent(event) {
    if (!groupCfg.enabled) {
      await groupTrace(`skip: disabled (group ${event.group_id})`)
      return
    }
    const groupId = String(event.group_id ?? '').trim()
    if (!groupId) return
    if (groupAllowed.size === 0 || !groupAllowed.has(groupId)) {
      await groupTrace(`skip: group ${groupId} not in allowGroups`)
      return
    }
    await loadGroupMemory()
    await loadGroupSettings()

    const segments = Array.isArray(event.message) ? event.message : []
    const sender = event.sender || {}
    const name = String(sender.card || sender.nickname || '群友').slice(0, 24)
    const selfId = String(event.self_id ?? '')
    // NapCat's at-segment shape varies between versions (qq / user_id, string
    // vs number). A miss here silently swallows the message, so accept any real
    // at-segment in a fan group, and also check the raw CQ form.
    const atTargets = segments
      .filter((seg) => seg && (seg.type === 'at' || seg.type === 'mention'))
      .map((seg) => String(seg.data?.qq ?? seg.data?.user_id ?? seg.data?.uid ?? '').trim())
    const rawText = String(event.raw_message || '')
    const mentioned =
      atTargets.some((qq) => qq === selfId || qq === '' || qq === 'all' || qq === 'everyone') ||
      (selfId ? rawText.includes(`[CQ:at,qq=${selfId}]`) : false)

    let text = messageText(event).replace(/^@[^\s]+\s*/u, '').trim()
    // A voice segment arrives as "[CQ:record,file=...]" — messageText falls back
    // to raw_message, which is truthy and used to swallow the voice path. Only
    // real text segments count as text here.
    const hasRecord = segments.some((seg) => seg && seg.type === 'record')
    const hasTypedText = segments.some(
      (seg) => seg && seg.type === 'text' && String(seg.data?.text || '').trim(),
    )
    if (hasRecord && !hasTypedText) text = ''
    // Voice in a group: transcribe locally and treat it like typed text. This
    // runs even without an @ so the words land in history for the next message.
    if (!text && hasRecord) {
      for (const seg of segments) {
        if (!seg || seg.type !== 'record') continue
        const heard = await transcribeVoice(seg)
        if (heard) {
          text = heard
          break
        }
      }
      if (text) {
        await groupTrace(`voice -> ${text.slice(0, 60)}`)
      } else if (mentioned) {
        await groupSay(groupId, '没听清，再说一遍？')
      }
    }
    await groupTrace(
      `recv group=${groupId} from=${name} self=${selfId} at=${mentioned} ats=${JSON.stringify(atTargets)} text=${text.slice(0, 40)}`,
    )
    if (!text) {
      await groupTrace('skip: empty text')
      return
    }

    const wakeWords = (groupCfg.wakeWords || []).map((w) => String(w || '').trim()).filter(Boolean)
    const woken = wakeWords.some((w) => text.startsWith(w))
    if (needsMention() && !mentioned && !woken) {
      // Keep the tail of the conversation for context, but do not answer.
      pushGroupHistory(groupId, 'user', `${name}: ${text}`)
      await groupTrace(
        `skip: not mentioned / no wake word | segments=${JSON.stringify(segments).slice(0, 240)}`,
      )
      return
    }
    if (woken) {
      const hit = wakeWords.find((w) => text.startsWith(w)) || ''
      text = text.slice(hit.length).trim()
      if (!text) return
    }

    const now = Date.now()
    const stamps = (groupStamps.get(groupId) || []).filter((t) => now - t < 60_000)
    if (stamps.length >= (Number(groupCfg.maxPerMinute) || DEFAULTS.group.maxPerMinute)) {
      log.info?.(`qq: [群 ${groupId}] 一分钟内说太多，跳过`)
      await groupTrace('skip: rate limited')
      return
    }
    if (now - (groupLastReply.get(groupId) || 0) < (Number(groupCfg.cooldownMs) || DEFAULTS.group.cooldownMs)) {
      await groupTrace('skip: cooldown')
      return
    }
    stamps.push(now)
    groupStamps.set(groupId, stamps)

    const messages = [
      { role: 'system', content: groupSystemPrompt(groupId) },
      ...(groupHistory.get(groupId) || []),
      { role: 'user', content: `${name}: ${text}` },
    ]

    let reply
    await groupTrace(`ask model=${effectiveGroupModel()} msgs=${messages.length}`)
    try {
      reply = await askGroupModel(messages)
    } catch (error) {
      log.warn?.(
        `qq: [群 ${groupId}] 本地模型没回：${error instanceof Error ? error.message : String(error)}`,
      )
      await groupTrace(`model error: ${error instanceof Error ? error.message : String(error)}`)
      return
    }

    const limit = Number(groupCfg.maxChars) || DEFAULTS.group.maxChars
    // One line, always: a chat message with line breaks reads like a wall.
    const oneLine = plainText(reply).replace(/\s*\n+\s*/g, ' ')
    const clean = splitText(oneLine, limit)[0].trim()
    if (!clean) {
      await groupTrace('skip: empty reply after cleanup')
      return
    }

    try {
      await callApi('send_group_msg', {
        group_id: /^\d+$/.test(groupId) ? Number(groupId) : groupId,
        message: clean,
      })
    } catch (error) {
      log.warn?.(
        `qq: [群 ${groupId}] 发不出去：${error instanceof Error ? error.message : String(error)}`,
      )
      await groupTrace(`send error: ${error instanceof Error ? error.message : String(error)}`)
      return
    }
    await groupTrace(`sent: ${clean.slice(0, 60)}`)

    groupLastReply.set(groupId, Date.now())
    pushGroupHistory(groupId, 'user', `${name}: ${text}`)
    pushGroupHistory(groupId, 'assistant', clean)
    log.info?.(`qq: [群 ${groupId}] ${name}: ${text.slice(0, 30)} -> ${clean.slice(0, 30)}`)

    // Every few exchanges, fold the tail into one short line. A 4B model's
    // patience for raw history is short; the summary is what survives.
    const exchanges = (groupExchange.get(groupId) || 0) + 1
    const every = Math.max(2, Number(groupCfg.summaryEvery) || DEFAULTS.group.summaryEvery)
    if (exchanges >= every) {
      groupExchange.set(groupId, 0)
      await summarizeGroup(groupId)
    } else {
      groupExchange.set(groupId, exchanges)
    }
  }

  // ----------------------------------------------------------- model pick ---

  /**
   * Session-local model switching over QQ. DSH exposes a runtime API
   * (modelCatalog + selectModel), so switching never needs a restart — only
   * this plugin code does, once.
   */
  async function loadModelCatalog() {
    if (typeof ctx.sessionController?.modelCatalog !== 'function') {
      throw new Error('这个 DSH 版本没有模型目录接口')
    }
    const catalog = await ctx.sessionController.modelCatalog()
    const groups = Array.isArray(catalog?.groups) ? catalog.groups : []
    const flat = []
    for (const group of groups) {
      const provider = String(group?.id ?? group?.provider ?? '')
      const models = Array.isArray(group?.models) ? group.models : []
      for (const entry of models) {
        const model = String(entry?.id ?? entry?.model ?? '')
        if (!provider || !model) continue
        flat.push({
          provider,
          model,
          label: `${provider} / ${String(entry?.label ?? entry?.name ?? model)}`,
        })
      }
    }
    return { catalog, flat }
  }

  async function currentModelSelection(sid) {
    try {
      if (typeof ctx.sessionController?.projections !== 'function') return undefined
      const res = await ctx.sessionController.projections({ sessionId: sid })
      const values = res?.kind === 'sequenced' ? res.values : undefined
      const selection = values?.modelSelection?.next || values?.modelSelection?.lastUsed
      if (selection?.provider && selection?.model) return selection
    } catch {
      /* best effort */
    }
    return undefined
  }

  const contextWatch = new Map()
  let localModelsCache = { at: 0, contexts: {} }

  /** LM Studio reports the window it actually loaded; cache for a minute. */
  async function loadedContextFor(modelId) {
    if (Date.now() - localModelsCache.at > 60_000) {
      try {
        const origin = new URL(groupCfg.baseUrl || DEFAULTS.group.baseUrl).origin
        const res = await getJson(`${origin}/api/v0/models`, 5000)
        const contexts = {}
        for (const entry of res?.body?.data || []) {
          if (entry?.id) contexts[String(entry.id)] = Number(entry.loaded_context_length) || 0
        }
        localModelsCache = { at: Date.now(), contexts }
      } catch {
        localModelsCache = { at: Date.now(), contexts: localModelsCache.contexts || {} }
      }
    }
    return localModelsCache.contexts[String(modelId)] || 0
  }

  /** Cumulative prompt tokens the session has sent, across the known fields. */
  function tokenTotals(values) {
    const totals = values?.tokenUsage?.totals
    if (!totals) return 0
    const pick = (key) => Number(totals[key]) || 0
    return (
      pick('uncachedInputTokens') +
      pick('cacheReadTokens') +
      pick('cacheWriteTokens') +
      pick('cachedInputTokens')
    )
  }

  /**
   * Local models have a hard window. After every turn, compare the prompt the
   * session actually sent against the loaded context and warn the owner before
   * the next request dies with "exceeds context size".
   */
  async function watchLocalContext(sid) {
    if (!ownerUin || !sid) return
    let values
    try {
      const res = await ctx.sessionController.projections({ sessionId: sid })
      values = res?.kind === 'sequenced' ? res.values : undefined
    } catch {
      return
    }
    const selection = values?.modelSelection?.next || values?.modelSelection?.lastUsed
    if (!selection?.model || /deepseek/i.test(String(selection.provider || ''))) return
    const total = tokenTotals(values)
    const previous = contextWatch.get(sid)
    const delta = total - (previous?.total || 0)
    contextWatch.set(sid, { total, warnedAt: previous?.warnedAt || 0 })
    if (delta <= 0) return
    const window = await loadedContextFor(selection.model)
    if (!window) return
    const ratio = delta / window
    if (ratio < 0.75) return
    const now = Date.now()
    if (now - (previous?.warnedAt || 0) < 600_000) return
    contextWatch.set(sid, { total, warnedAt: now })
    const used = Math.round(ratio * 100)
    const message =
      ratio >= 1
        ? `上下文超了（上次请求 ${delta} / 窗口 ${window}）。发「挂了」开个新总机，再 /模型 切回本地模型。`
        : `上下文用到 ${used}%（${delta} / ${window}），再说几句就满了。快满时发「挂了」开个新总机。`
    sendText(ownerUin, message).catch(() => {})
    log.info?.(`qq: context watch ${used}% (${delta}/${window}) on ${String(sid).slice(-8)}`)
  }

  /** Tolerate both request shapes across DSH versions: nested vs flattened. */
  async function applyModelSelection(sid, selection) {
    const attempts = [
      () => ctx.sessionController.selectModel({ sessionId: sid, selection }),
      () => ctx.sessionController.selectModel({ sessionId: sid, ...selection }),
    ]
    let lastError
    for (const attempt of attempts) {
      try {
        return await attempt()
      } catch (error) {
        lastError = error
      }
    }
    throw lastError instanceof Error ? lastError : new Error(String(lastError))
  }

  async function modelCommandReply(argument) {
    const { catalog, flat } = await loadModelCatalog()
    if (flat.length === 0) return '模型目录是空的，provider 可能都没起来。'
    const sid = await ensureSession()
    const current = await currentModelSelection(sid)
    const currentKey = current ? `${current.provider}/${current.model}` : ''
    const arg = String(argument || '').trim()

    if (!arg) {
      const lines = flat.map((item, index) => {
        const mark = currentKey === `${item.provider}/${item.model}` ? '  ← 当前' : ''
        return `${index + 1}. ${item.label}${mark}`
      })
      return `${lines.join('\n')}\n\n现在：${currentKey || '未知'}\n发「/模型 2」切换，「/模型 恢复」回默认。`
    }

    if (/^(恢复|默认|reset|default)$/i.test(arg)) {
      const fallback = catalog?.default ?? catalog?.defaultSelection ?? catalog?.deploymentDefault
      if (!fallback?.provider || !fallback?.model) return '没拿到默认模型，在 GUI 的设置里选一次吧。'
      await applyModelSelection(sid, { provider: fallback.provider, model: fallback.model })
      return `已切回默认：${fallback.provider} / ${fallback.model}`
    }

    let target
    const index = Number(arg)
    if (Number.isInteger(index) && index >= 1 && index <= flat.length) target = flat[index - 1]
    if (!target) {
      const needle = arg.toLowerCase()
      target = flat.find(
        (item) =>
          item.model.toLowerCase().includes(needle) || item.label.toLowerCase().includes(needle),
      )
    }
    if (!target) return `没找到「${arg}」。发「/模型」看列表。`

    await applyModelSelection(sid, { provider: target.provider, model: target.model })
    // Local models cannot hold a long agent session: say so before the owner
    // hits "exceeds context size" on the next message.
    const isLocal = !/deepseek/i.test(target.provider) && !/deepseek/i.test(target.model)
    if (isLocal) {
      return `已切到 ${target.label}。\n注意：本地模型窗口小，这个会话历史一长就会报超出上下文。先发「挂了」开一个新总机，再切本地模型，能聊得久一些。`
    }
    return `已切到 ${target.label}。`
  }

  // -------------------------------------------------------------- inbound ---

  async function handleEvent(event) {
    if (!event || typeof event !== 'object') return
    if (event.post_type !== 'message') return
    // Group traffic never touches the private-call path: it is answered (or
    // ignored) by the local model, with no session, no binding, no tools.
    if (event.message_type === 'group') return handleGroupEvent(event)
    const uin = String(event.user_id || '')
    if (!uin) return
    if (!allowed.has(uin)) {
      log.warn(`qq: dropped message from ${uin} (not in allowUins)`)
      return
    }
    let text = messageText(event)
    // messageText falls back to raw_message, so a voice-only message looks like
    // "[CQ:record,file=...]" and used to skip the transcription path entirely.
    const segs = Array.isArray(event.message) ? event.message : []
    const hasRecord = segs.some((seg) => seg && seg.type === 'record')
    const hasTypedText = segs.some(
      (seg) => seg && seg.type === 'text' && String(seg.data?.text || '').trim(),
    )
    if (hasRecord && !hasTypedText) text = ''
    if (!text) {
      // A voice message can be transcribed locally; anything else is not text.
      const voices = (Array.isArray(event.message) ? event.message : []).filter(
        (seg) => seg && seg.type === 'record',
      )
      if (voices.length > 0) {
        for (const seg of voices) {
          const heard = await transcribeVoice(seg)
          if (heard) {
            text = text ? `${text}\n${heard}` : heard
            break
          }
        }
        if (text) log.info?.(`qq: transcribed voice -> ${text.slice(0, 40)}`)
      }
    }

    // Images travel as real image parts, so a photo from the phone can be seen
    // by the session instead of being answered with "读不了".
    const imageParts = []
    for (const seg of Array.isArray(event.message) ? event.message : []) {
      if (!seg || seg.type !== 'image') continue
      try {
        const part = await imagePart(seg)
        if (part) imageParts.push(part)
      } catch (error) {
        log.warn(`qq: image intake failed: ${error instanceof Error ? error.message : String(error)}`)
      }
    }
    if (imageParts.length > 0) {
      log.info?.(`qq: attached ${imageParts.length} image(s) to the prompt`)
    }

    if (!text && imageParts.length === 0) {
      // Video, files and stickers carry no usable content: say so instead of
      // dropping the message and leaving the owner wondering.
      const kinds = (Array.isArray(event.message) ? event.message : [])
        .map((seg) => seg && seg.type)
        .filter((t) => typeof t === 'string' && t !== 'text')
      if (kinds.length > 0) {
        const label = { image: '图片', record: '语音', video: '视频', file: '文件', face: '表情' }
        const names = [...new Set(kinds)].map((k) => label[k] || k)
        sendText(uin, `这条我只收到${names.join('、')}，读不了内容。要说事还是打字吧。`).catch(() => {})
      }
      return
    }
    if (ownerUin !== uin) {
      ownerUin = uin
      await saveState({ ownerUin })
    }
    if (pendingApproval) {
      // Only a real yes/no settles the pending approval. Anything else is a
      // normal message and must not be swallowed by the approval waiter.
      const answer = parseAnswer(text)
      if (answer) {
        pendingApproval.settle(answer)
      } else {
        sendText(uin, '还在等审批答复：回「允许」或「拒绝」。其它话等这条处理完再说。').catch(() => {})
      }
      return
    }
    if (pendingQuestion) {
      // The answer is consumed here; it never becomes a normal prompt.
      pendingQuestion.settle(text)
      return
    }
    // "在看什么" is answered by the bridge itself: asking what every session is
    // doing must not queue behind whichever turn is currently running.
    const activityCommand =
      /^[/／]?(任务|任务进度|进度|在看什么|忙什么|干什么|会话任务|jobs?|activity|tasks?)(?:\s+([\s\S]{1,40}))?$/i.exec(
        text.trim(),
      )
    if (activityCommand) {
      try {
        await sendText(uin, await activitySnapshot(activityCommand[2] || ''))
      } catch (error) {
        await recordError('activity', error)
        sendText(uin, '没拿到任务快照，等会儿再试。').catch(() => {})
      }
      return
    }
    // Reply-mode switch: /群回复 toggles "must be @'d", accepts 开 / 关 too.
    const groupReplyHead = /^(群回复|群模式|群聊回复|groupreply)([\s\S]*)$/i.exec(
      text.trim().replace(/^[/／]/, ''),
    )
    if (groupReplyHead) {
      const bare = groupReplyHead[2].trim()
      const known = /^(开|关|on|off|全部|只@|@|mention|always|all|要@|不用@|不用|)$/i.test(bare)
      if (known) {
        try {
          await sendText(uin, await groupReplyCommandReply(bare))
        } catch (error) {
          await recordError('group.reply.command', error)
          sendText(uin, '改不了群回复模式，等下再试。').catch(() => {})
        }
        return
      }
    }
    // Group-local model switch: /群模型 [n|恢复]. Separate from /模型 because
    // group chat bypasses sessions entirely and talks to LM Studio directly.
    const groupModelHead = /^(群模型|组模型|groupmodel)([\s\S]*)$/i.exec(
      text.trim().replace(/^[/／]/, ''),
    )
    let groupModelArgument
    if (groupModelHead) {
      const rest = groupModelHead[2]
      const bare = rest.trim()
      const looksLikeCommand =
        bare === '' ||
        /^\d{1,2}$/.test(bare) ||
        /^(恢复|默认|reset|default)$/i.test(bare) ||
        /^\s/.test(rest)
      if (looksLikeCommand) groupModelArgument = bare
    }
    if (groupModelArgument !== undefined) {
      try {
        await sendText(uin, await groupModelCommandReply(groupModelArgument))
      } catch (error) {
        await recordError('group.model.command', error)
        sendText(uin, `换不动群模型：${error instanceof Error ? error.message : String(error)}`).catch(
          () => {},
        )
      }
      return
    }
    // Model switching is a bridge-level control: it must work even when the
    // session is currently running a model too small to call tools.
    // Accept "/模型3" as well as "/模型 3": people do not type spaces.
    const modelHead = /^(切换模型|模型|model)([\s\S]*)$/i.exec(text.trim().replace(/^[/／]/, ''))
    let modelArgument
    if (modelHead) {
      const rest = modelHead[2]
      const bare = rest.trim()
      const looksLikeCommand =
        bare === '' ||
        /^\d{1,2}$/.test(bare) ||
        /^(恢复|默认|reset|default)$/i.test(bare) ||
        /^\s/.test(rest)
      if (looksLikeCommand) modelArgument = bare
    }
    if (modelArgument !== undefined) {
      try {
        await sendText(uin, await modelCommandReply(modelArgument))
      } catch (error) {
        await recordError('model.command', error)
        sendText(uin, `换不动：${error instanceof Error ? error.message : String(error)}`).catch(
          () => {},
        )
      }
      return
    }
    // "挂了" is a control instruction, not conversation. Handle it in the
    // bridge so it works from whichever session holds the call, without
    // waiting on that session's model or its rebind permission.
    const HANGUP_RE = /^(挂断|挂了|拜拜|再见|没事了|先这样|就这样|收工|下了|结束|退下|不聊了)[。.!！?？\s]*$/
    if (HANGUP_RE.test(text.trim())) {
      try {
        const fresh = await hangupToSwitchboard('qq-message:hangup')
        sendText(uin, '挂了，回到总机。').catch(() => {})
        log.info?.(`qq: hung up from chat, switchboard now ${fresh.slice(-8)}`)
      } catch (error) {
        sendText(uin, '挂断没成功，再试一次？').catch(() => {})
        await recordError('hangup.keyword', error)
      }
      return
    }
    try {
      const steer = /^(挂断|挂了|拜拜|再见|没事了|先这样|就这样|收工|下了|结束|退下|不聊了)/.test(
        text.trim(),
      )
      await promptSession(text, { steer, parts: imageParts })
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error)
      await recordError('session.prompt', error)
      // Tell the owner on QQ why nothing happened, instead of failing silently.
      if (message.includes('绑定')) await sendText(uin, message).catch(() => {})
      throw error
    }
  }

  // Inbound messages are handled one at a time: two near-simultaneous
  // messages would otherwise race on ensureSession and could bind twice.
  let inboundChain = Promise.resolve()
  function enqueueInbound(task) {
    const run = inboundChain.then(task, task)
    inboundChain = run.then(
      () => {},
      () => {},
    )
    return run
  }

  function startInbound() {
    const port = Number(cfg.listenPort) || DEFAULTS.listenPort
    server = http.createServer((req, res) => {
      if (req.method !== 'POST') {
        res.writeHead(405, { connection: 'close' })
        res.end()
        return
      }
      const chunks = []
      let size = 0
      req.on('data', (chunk) => {
        size += chunk.length
        if (size <= 4 * 1024 * 1024) chunks.push(chunk)
      })
      req.on('end', () => {
        res.writeHead(204, { connection: 'close' })
        res.end()
        let event
        try {
          event = JSON.parse(Buffer.concat(chunks).toString('utf8'))
        } catch {
          return
        }
        enqueueInbound(() => handleEvent(event)).catch((error) => {
          log.warn(`qq: handle failed: ${error instanceof Error ? error.message : String(error)}`)
        })      })
    })
    server.on('error', (error) => {
      log.warn(`qq: inbound listener failed on ${port}: ${error.message}`)
    })
    server.listen(port, '127.0.0.1', () => {
      log.info?.(`qq: listening for NapCat on http://127.0.0.1:${port}/`)
    })
  }

  function stopInbound() {
    if (!server) return
    try {
      server.close()
    } catch {
      /* already closed */
    }
    server = undefined
  }

  // ------------------------------------------------------------- replies ---

  // Registered through ctx.effect so a plugin reload releases the old
  // listener; a leaked one would keep replying from a stale session.
  ctx.effect(
    () =>
      ctx.on('session/event', (session, event) => {
        if (!sessionId || !session || String(session.id) !== String(sessionId)) return
        if (event.type === 'assistant/message') {
          const blocks = event.data?.message?.content ?? []
          const text = blocks
            .filter((block) => block && block.type === 'text')
            .map((block) => block.text ?? '')
            .join('')
          if (text.trim()) {
            // Cap the buffer: a turn that never ends must not grow it forever.
            if (replyByTurn.size > 64) {
              const oldest = replyByTurn.keys().next().value
              if (oldest !== undefined) replyByTurn.delete(oldest)
            }
            replyByTurn.set(event.data.turn, text)
          }
          return
        }
        if (event.type === 'turn/end') {
          const turn = event.data?.turn
          const text = replyByTurn.get(turn)
          replyByTurn.delete(turn)
          const reason = event.data?.reason?.kind
          if (!text || !text.trim()) {
            // An empty failed turn is usually a model-side 400 (context size,
            // overload). Watch the window instead of staying silent.
            if (reason === 'error') void watchLocalContext(sessionId).catch(() => {})
            return
          }
          const suffix =
            reason === 'aborted' ? '\n\n（这轮被打断了）' : reason === 'error' ? '\n\n（这轮出错了）' : ''
          sendText(ownerUin, text + suffix).catch((error) => {
            log.warn(`qq: reply failed: ${error instanceof Error ? error.message : String(error)}`)
          })
          void watchLocalContext(sessionId).catch(() => {})
        }
      }),
    'qq.session-events',
  )

  // ------------------------------------------------------------- activity ---

  // A live, self-capping view of what every session is doing right now. Fed by
  // session/event for ALL sessions (not just the bound one), so "/任务" can
  // answer without waiting behind whichever turn happens to be running.
  const report = new Map()

  function slot(sid) {
    let entry = report.get(sid)
    if (!entry) {
      entry = {
        sid,
        jobs: new Map(),
        todos: [],
        turn: null,
        turnStartedAt: 0,
        lastTool: '',
        lastToolAt: 0,
        lastDone: null,
        touchedAt: 0,
      }
      report.set(sid, entry)
    }
    return entry
  }

  function fmtDur(ms) {
    const total = Math.max(0, Math.round(ms / 1000))
    if (total < 60) return `${total}秒`
    const minutes = Math.floor(total / 60)
    if (minutes < 60) return `${minutes}分${total % 60}秒`
    const hours = Math.floor(minutes / 60)
    return `${hours}小时${minutes % 60}分`
  }

  function fmtAgo(at) {
    if (!at) return ''
    return `${fmtDur(Date.now() - at)}前`
  }

  /** Tool name out of a tool/call payload, tolerant of shape drift. */
  function toolNameOf(data) {
    return String(data?.name || data?.toolName || data?.tool?.name || data?.call?.name || '')
  }

  ctx.effect(
    () =>
      ctx.on('session/event', (session, event) => {
        const sid = session?.id ? String(session.id) : ''
        if (!sid || !event || typeof event.type !== 'string') return
        const now = Date.now()
        const entry = slot(sid)
        entry.touchedAt = now
        switch (event.type) {
          case 'job/registered': {
            const data = event.data || {}
            const jobId = String(data.jobId ?? '')
            if (!jobId || entry.jobs.size >= 32) break
            entry.jobs.set(jobId, {
              label: String(data.label || data.kind || '任务'),
              kind: String(data.kind || ''),
              startedAt: Number(data.startedAt) || now,
            })
            break
          }
          case 'job/settled': {
            const data = event.data || {}
            const job = entry.jobs.get(String(data.jobId ?? ''))
            if (job) {
              entry.jobs.delete(String(data.jobId ?? ''))
              entry.lastDone = { label: job.label, at: Number(data.finishedAt) || now }
            }
            break
          }
          case 'turn/start': {
            entry.turn = Number(event.data?.turn ?? 0) || null
            entry.turnStartedAt = now
            break
          }
          case 'turn/end': {
            entry.turn = null
            entry.turnStartedAt = 0
            break
          }
          case 'tool/call': {
            const name = toolNameOf(event.data)
            if (name) {
              entry.lastTool = name
              entry.lastToolAt = now
            }
            if (!entry.turnStartedAt) entry.turnStartedAt = now
            break
          }
          case 'todo/write': {
            const todos = Array.isArray(event.data?.todos) ? event.data.todos : []
            entry.todos = todos.slice(0, 20).map((todo) => ({
              content: String(todo?.content ?? ''),
              status: String(todo?.status ?? 'pending'),
            }))
            break
          }
          default:
            break
        }
      }),
    'qq.activity-events',
  )

  /**
   * One phone-sized snapshot: which sessions are running, which background jobs
   * they hold, how far their todo list has got. `filter` keeps one session
   * (1-based index, title fragment, or the last 8 characters of its id).
   */
  async function activitySnapshot(filter = '') {
    const raw = String(filter || '').trim()
    const includeNoise = /^(all|全部|\*)$/i.test(raw) || /\sall$/i.test(raw)
    const { rows, hiddenNoise } = await sessionRows(includeNoise)
    const numbered = rows.map((row) => ({ row, state: report.get(row.sessionId) }))
    const isBusy = ({ row, state }) => Boolean(row.running) || (state ? state.jobs.size > 0 : false)
    const ordered = numbered
      .sort((a, b) => {
        if (a.row.bound !== b.row.bound) return a.row.bound ? -1 : 1
        if (isBusy(a) !== isBusy(b)) return isBusy(a) ? -1 : 1
        return String(b.row.updatedAt).localeCompare(String(a.row.updatedAt))
      })
      // Number after sorting so "／任务 2" always means the second line printed.
      .map((item, index) => ({ ...item, index: index + 1 }))
    const want = raw && !/^(all|全部|\*)$/i.test(raw) ? raw.toLowerCase().replace(/\s+all$/i, '') : ''
    const shown = want
      ? ordered.filter(({ row, index }) => {
          if (/^\d+$/.test(want)) return String(index) === want
          return (
            String(row.title).toLowerCase().includes(want) ||
            row.short === want ||
            String(row.sessionId).toLowerCase().endsWith(want)
          )
        })
      : ordered

    const lines = []
    const stamp = new Date().toLocaleTimeString('zh-CN', { hour12: false }).slice(0, 5)
    lines.push(`【会话任务】${stamp}`)
    if (want && shown.length === 0) {
      lines.push(`没有对上下标的会话：${want}`)
      return lines.join('\n')
    }
    const limit = Math.min(shown.length, includeNoise ? 30 : 10)
    for (let i = 0; i < limit; i += 1) {
      const { row, index, state } = shown[i]
      const busy = isBusy({ row, state })
      const name = row.title || row.short
      const suffix = row.bound ? ' ★接通中' : ''
      const elapsed = state?.turnStartedAt ? Date.now() - state.turnStartedAt : 0
      const running = busy ? `跑着${elapsed > 10_000 ? ` ${fmtDur(elapsed)}` : ''}` : '空闲'
      lines.push(`${index}. ${name}${suffix} — ${running}`)
      const values = row.values || {}
      const goal = values.goal?.goal
      const teamTasks = Array.isArray(values.agentTeam?.tasks)
        ? values.agentTeam.tasks.filter((task) => task && task.status !== 'completed')
        : []
      let details = 0
      if (state) {
        const jobs = [...state.jobs.values()].slice(0, 3)
        for (const job of jobs) {
          const body = job.kind && job.kind !== job.label ? `${job.kind}「${job.label}」` : `「${job.label}」`
          lines.push(`   ▸ 后台 ${body} 已跑 ${fmtDur(Date.now() - job.startedAt)}`)
          details += 1
        }
        if (state.todos.length > 0 && details < 4) {
          const done = state.todos.filter((todo) => todo.status === 'completed').length
          const current = state.todos.find((todo) => todo.status === 'in_progress')
          lines.push(
            `   ▸ 待办 ${done}/${state.todos.length}${current ? ` · 进行中：${current.content}` : ''}`,
          )
          details += 1
        }
      }
      if (goal && details < 4) {
        const phase = { active: '进行中', paused: '暂停', blocked: '卡住', complete: '已完成' }[goal.phase] || goal.phase
        const rounds = goal.roundsStarted ? `，第 ${goal.roundsStarted} 轮` : ''
        lines.push(`   ▸ 目标：${goal.objective}（${phase}${rounds}）`)
        details += 1
      }
      if (teamTasks.length > 0 && details < 4) {
        const first = teamTasks[0]
        const subject = String(first.subject || first.description || '').slice(0, 40)
        lines.push(`   ▸ 小队 ${teamTasks.length} 项未完：${subject}`)
        details += 1
      }
      if (values.plan?.active && details < 4) {
        lines.push('   ▸ 计划模式开着')
        details += 1
      }
      if (state && details < 4) {
        if (busy && state.lastTool && Date.now() - state.lastToolAt < 10 * 60 * 1000) {
          lines.push(`   ▸ 最近动作：${state.lastTool}`)
        } else if (!busy && state.lastDone && Date.now() - state.lastDone.at < 30 * 60 * 1000) {
          lines.push(`   ▸ 刚跑完「${state.lastDone.label}」${fmtAgo(state.lastDone.at)}`)
        }
      }
      if (busy && !row.running) lines.push('   ▸ 没有活动中的回合，只剩后台任务')
    }
    if (shown.length > limit) lines.push(`… 还有 ${shown.length - limit} 个没列出（/任务 all 全列）`)
    const busyCount = ordered.filter(isBusy).length
    const noise = hiddenNoise > 0 && !includeNoise ? `，另有 ${hiddenNoise} 个内部会话没列（/任务 all）` : ''
    lines.push('')
    lines.push(`共 ${ordered.length} 个会话，${busyCount} 个在跑${noise}`)
    if (!want) lines.push('看单个：/任务 2（或 /任务 标题片段）')
    return lines.join('\n').replace(/\n{3,}/g, '\n\n').trim()
  }

  // ------------------------------------------------------------ approvals ---

  function forwardApproval(req, uin) {
    const reason = req?.reason ?? ''
    const toolName = req?.toolName ?? '工具'
    const prompt =
      reason.length > 0
        ? `[审批] ${toolName}（${reason}）要执行。回「允许」或「拒绝」。`
        : `[审批] ${toolName} 要执行。回「允许」或「拒绝」。`
    return new Promise((resolve) => {
      let settled = false
      const finish = (outcome) => {
        if (settled) return
        settled = true
        pendingApproval = undefined
        req?.signal?.removeEventListener?.('abort', onAbort)
        resolve(outcome)
      }
      const onAbort = () => finish('cancelled')
      // settle() now receives an already-decided outcome ('allowed-once' |
      // 'rejected'); a text fallback keeps older call sites working.
      pendingApproval = {
        settle: (outcome) => finish(typeof outcome === 'string' ? outcome : parseAnswer(outcome) || 'rejected'),
      }
      req?.signal?.addEventListener?.('abort', onAbort, { once: true })
      sendText(uin, prompt).catch(() => finish('unavailable'))
    })
  }

  ctx.effect(
    () =>
      ctx.on(
        'approval/request',
        (req, next) => {
          if (!sessionId || !ownerUin) return next()
          if (String(req?.agent?.id) !== String(sessionId)) return next()
          return forwardApproval(req, ownerUin)
        },
        { prepend: true },
      ),
    'qq.approval-events',
  )

  // ------------------------------------------------------------- questions ---

  /** Render one ask_user_question question as compact QQ text. */
  function formatQuestion(questions) {
    const q = questions[0]
    if (!q) return '（没有要问的）'
    const lines = []
    lines.push(q.header ? `【${q.header}】` : '【问你】')
    lines.push(String(q.question || ''))
    if (q.detail) lines.push(String(q.detail))
    const options = Array.isArray(q.options) ? q.options : []
    if (options.length > 0) {
      lines.push('')
      options.forEach((opt, i) => {
        const desc = opt.description ? ` — ${opt.description}` : ''
        lines.push(`${i + 1}. ${opt.label}${desc}`)
      })
      lines.push('')
      lines.push(
        q.multiSelect
          ? '回复编号（多个用逗号，如 1,3），或直接打字当自定义回答。'
          : '回复编号，或直接打字当自定义回答。',
      )
    } else {
      lines.push('')
      lines.push('直接打字回复。')
    }
    return lines.join('\n')
  }

  /** Translate the owner's QQ reply into the structured answer batch. */
  function parseQuestionReply(questions, text) {
    const t = String(text || '').trim()
    if (!t) return undefined
    // Only the first question is asked on QQ; extra ones get the same answer
    // shape with an empty selection so the batch still validates.
    const q = questions[0]
    if (!q) return { answers: [] }
    const options = Array.isArray(q.options) ? q.options : []
    const byLabel = (s) => options.find((o) => String(o.label) === s)

    // "1" or "1,3"
    if (/^\d+(\s*[,，]\s*\d+)*$/.test(t)) {
      const picked = t
        .split(/[,，]/)
        .map((n) => Number(n.trim()) - 1)
        .filter((i) => i >= 0 && i < options.length)
        .map((i) => options[i].label)
      if (picked.length > 0) {
        return {
          answers: questions.map((item, index) => ({
            id: item.id,
            selected: index === 0 ? picked : [],
          })),
        }
      }
    }

    // Exact option text
    const hit = byLabel(t)
    if (hit) {
      return {
        answers: questions.map((item, index) => ({
          id: item.id,
          selected: index === 0 ? [hit.label] : [],
        })),
      }
    }

    // Free text becomes the custom answer for the first question.
    return {
      answers: questions.map((item, index) => ({
        id: item.id,
        selected: [],
        ...(index === 0 ? { custom: t } : {}),
      })),
    }
  }

  function forwardQuestion(request, uin) {
    const questions = Array.isArray(request?.questions) ? request.questions : []
    if (questions.length === 0) return Promise.resolve({ answers: [] })
    return new Promise((resolve) => {
      let settled = false
      const finish = (answer) => {
        if (settled) return
        settled = true
        pendingQuestion = undefined
        request?.signal?.removeEventListener?.('abort', onAbort)
        resolve(answer ?? { answers: [] })
      }
      const onAbort = () => finish(null)
      pendingQuestion = {
        settle: (text) => {
          const answer = parseQuestionReply(questions, text)
          finish(answer ?? null)
        },
      }
      request?.signal?.addEventListener?.('abort', onAbort, { once: true })
      sendText(uin, formatQuestion(questions)).catch(() => finish(null))
    })
  }

  ctx.effect(
    () =>
      ctx.on(
        'user-questions/request',
        (request, next) => {
          if (!sessionId || !ownerUin) return next()
          if (String(request?.agent?.id) !== String(sessionId)) return next()
          return forwardQuestion(request, ownerUin)
        },
        { prepend: true },
      ),
    'qq.question-events',
  )

  // -------------------------------------------------------------- command ---

  ctx.effect(
    () =>
      ctx.commands.register({
        name: 'qq',
        description:
          'Connect this session to QQ. `/qq bind` makes QQ private messages drive THIS session; `/qq status` shows the bridge; `/qq off` unbinds.',
        handler: async (invocation) => {
          const arg = String(invocation.rawInput || '').trim().toLowerCase()
          if (arg === 'bind' || arg === 'on') {
            await setBinding(String(invocation.agent.id), 'command:/qq bind', invocation.agent.id)
            return {
              kind: 'success',
              text:
                `这个会话已经接到 QQ 上了。\n` +
                `之后从 QQ 私聊发来的消息会进这里，回答也会发回 QQ。\n` +
                `（session: ${sessionId}）`,
            }
          }
          if (arg === 'off' || arg === 'unbind') {
            await setBinding('', 'command:/qq off', invocation.agent.id)
            return { kind: 'success', text: '已解除 QQ 绑定。' }
          }
          if (arg === 'jobs' || arg.startsWith('jobs ') || arg === 'activity' || arg.startsWith('activity ') || arg === '任务') {
            const wanted = arg.replace(/^(jobs|activity|任务)\s*/i, '').trim()
            return { kind: 'success', text: await activitySnapshot(wanted) }
          }
          return {
            kind: 'success',
            text: [
              `绑定会话：${sessionId ? sessionId : '否（用 /qq bind 绑）'}`,
              `最近发消息的号：${ownerUin || '（还没有）'}`,
              `白名单：${[...allowed].join(', ') || '（空，谁都不能用）'}`,
              `NapCat 地址：${cfg.napcatUrl}`,
            ].join('\n'),
          }
        },
      }),
    'qq.command',
  )

  // ---------------------------------------------------------------- tools ---

  const text = (value) => [{ type: 'text', text: value }]

  ctx.effect(
    () =>
      ctx.tools.register({
        name: 'qq_send_message',
        description:
          'Send a short note to the owner\'s QQ private chat (progress reports, "done", "starting now"). ' +
          '给主人的 QQ 私聊推一段话：汇报进度、报告完成、说一声开始干活。' +
          'Keep it under a few hundred characters; long text is split automatically. ' +
          'This does not end the turn — you can keep working afterwards.',
        parameters: {
          type: 'object',
          properties: {
            text: { type: 'string', description: '要发的内容（中文即可）。' },
          },
          required: ['text'],
        },
        output: {
          schema: {
            type: 'object',
            properties: { ok: { type: 'boolean' }, chunks: { type: 'integer' }, to: { type: 'string' }, error: { type: 'string' } },
            required: ['ok'],
          },
          render(_args, value) {
            if (!value?.ok) return text(`没发出去：${value?.error || '未知原因'}`)
            return text(`已发到 QQ ${value.to}（${value.chunks} 段）。`)
          },
        },
        timeoutMs: 30_000,
        isConcurrencySafe: () => true,
        async execute(args, exec) {
          if (!(await mayEmit(exec))) return { ok: false, error: EMIT_DENIED }
          const target = String(ownerUin || '').trim()
          if (!target) return { ok: false, error: '还没有 QQ 号，先让对方发一条消息' }
          const chunks = await sendText(target, args.text)
          return { ok: true, chunks, to: target }
        },
      }),
    'qq.tool.send_message',
  )

  ctx.effect(
    () =>
      ctx.tools.register({
        name: 'qq_activity',
        description:
          'Live snapshot of what every DSH session is doing right now: running turns, background jobs with their ' +
          'elapsed time, todo progress. This is exactly what the owner gets by sending /任务 on QQ. ' +
          '看每个会话现在在干什么（跑着的回合、后台任务、待办进度），和 QQ 上发 /任务 得到的是同一份。',
        parameters: {
          type: 'object',
          properties: {
            filter: {
              type: 'string',
              description: '可选：序号（如 2）、标题片段、或 session 尾号，只看一个会话。',
