const ALLOW_WORDS = new Set(['允许', '允许执行', '同意', '可以', '是', '确认', 'y', 'yes', 'ok', 'allow', 'accept', '1'])
const REJECT_WORDS = new Set(['拒绝', '不同意', '禁止', '否', '取消', 'n', 'no', 'deny', 'reject', '0'])

const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
const execFileP = promisify(execFile)

/** Parse an inbound reply into an approval decision (whole word, or first token). */
function parseAnswer(text) {
  const normalized = String(text || '').trim().toLowerCase()
  if (!normalized) return undefined
  if (ALLOW_WORDS.has(normalized)) return 'allowed-once'
  if (REJECT_WORDS.has(normalized)) return 'rejected'
  const first = normalized.split(/[\s,，。.!！?？、:：;；/]+/u)[0] || ''
  if (ALLOW_WORDS.has(first)) return 'allowed-once'
  if (REJECT_WORDS.has(first)) return 'rejected'
  return undefined
}

/** Split text into chat-sized chunks without breaking surrogate pairs. */
function splitText(text, max) {
  const out = []
  let rest = String(text ?? '')
  while (rest.length > max) {
    let cut = rest.lastIndexOf('\n', max)
    if (cut < max * 0.5) cut = max
    out.push(rest.slice(0, cut))
    rest = rest.slice(cut).replace(/^\n+/, '')
  }
  if (rest.length) out.push(rest)
  return out
}

/** Pull the human text out of an OneBot message segment array. */
function messageText(event) {
  const message = event?.message
  if (typeof message === 'string') return message.trim()
  if (Array.isArray(message)) {
    const joined = message
      .filter((seg) => seg && seg.type === 'text')
      .map((seg) => seg.data?.text ?? '')
      .join('')
    if (joined.trim()) return joined.trim()
  }
  return typeof event?.raw_message === 'string' ? event.raw_message.trim() : ''
}

/** One JSON POST over node:http(s) — dependency-free and timeout-bounded. */
function postJson(url, body, headers = {}, timeoutMs = 15000) {
  return new Promise((resolve, reject) => {
    let target
    try {
      target = new URL(url)
    } catch {
      reject(new Error(`invalid url: ${url}`))
      return
    }
    const payload = Buffer.from(JSON.stringify(body ?? {}), 'utf8')
    // node:http refuses https URLs outright, so pick the transport by scheme.
    const client = target.protocol === 'https:' ? https : http
    const req = client.request(
      {
        protocol: target.protocol,
        hostname: target.hostname,
        port: target.port || (target.protocol === 'https:' ? 443 : 80),
        path: target.pathname + target.search,
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'content-length': payload.length,
          ...headers,
        },
      },
      (res) => {
        const chunks = []
        res.on('data', (c) => chunks.push(c))
        res.on('end', () => {
          const raw = Buffer.concat(chunks).toString('utf8')
          if (!raw) return resolve({ statusCode: res.statusCode, body: null })
          try {
            resolve({ statusCode: res.statusCode, body: JSON.parse(raw) })
          } catch {
            resolve({ statusCode: res.statusCode, body: raw })
          }
        })
      },
    )
    req.setTimeout(timeoutMs, () => req.destroy(new Error('timeout')))
    req.on('error', reject)
    req.end(payload)
  })
}

/** One JSON GET over node:http — used to ask LM Studio what it serves. */
function getJson(url, timeoutMs = 8000) {
  return new Promise((resolve, reject) => {
    let target
    try {
      target = new URL(url)
    } catch {
      reject(new Error(`invalid url: ${url}`))
      return
    }
    const client = target.protocol === 'https:' ? https : http
    const req = client.request(
      {
        protocol: target.protocol,
        hostname: target.hostname,
        port: target.port || (target.protocol === 'https:' ? 443 : 80),
        path: target.pathname + target.search,
        method: 'GET',
      },
      (res) => {
        const chunks = []
        res.on('data', (c) => chunks.push(c))
        res.on('end', () => {
          const raw = Buffer.concat(chunks).toString('utf8')
          if (!raw) return resolve({ statusCode: res.statusCode, body: null })
          try {
            resolve({ statusCode: res.statusCode, body: JSON.parse(raw) })
          } catch {
            resolve({ statusCode: res.statusCode, body: raw })
          }
        })
      },
    )
    req.setTimeout(timeoutMs, () => req.destroy(new Error('timeout')))
    req.on('error', reject)
    req.end()
  })
}

export function apply(ctx, config) {
  const cfg = { ...DEFAULTS, ...(config || {}) }
  const allowed = new Set((cfg.allowUins || []).map((v) => String(v).trim()).filter(Boolean))
  const maxChars = Number(cfg.maxChars) > 200 ? Number(cfg.maxChars) : DEFAULTS.maxChars
  const log = ctx.logger ?? { warn: () => {}, info: () => {}, debug: () => {} }

  const stateFile = path.join(cfg.dataDir, 'state.json')

  let server
  let sessionId
  let lilySessionId
  let ownerUin = ''
  let pendingApproval
  let pendingQuestion
  let started = false
  const replyByTurn = new Map()

  // ---------------------------------------------------------------- state ---

  async function loadState() {
    try {
      const raw = await readFile(stateFile, 'utf8')
      const parsed = JSON.parse(raw)
      return parsed && typeof parsed === 'object' ? parsed : {}
    } catch {
      return {}
    }
  }

  async function saveState(patch) {
    try {
      const current = await loadState()
      const next = { ...current, ...patch }
      await mkdir(cfg.dataDir, { recursive: true })
      await writeFile(stateFile, `${JSON.stringify(next, null, 2)}\n`, 'utf8')
    } catch (error) {
      log.warn(`qq: state write failed: ${error instanceof Error ? error.message : String(error)}`)
    }
  }

  /** Append one line to the binding audit trail: who changed what, when. */
  async function appendAudit(entry) {
    try {
      await mkdir(cfg.dataDir, { recursive: true })
      await appendFile(path.join(cfg.dataDir, 'bind.log'), `${JSON.stringify(entry)}\n`, 'utf8')
    } catch {
      /* audit must never break the bridge */
    }
  }

  /**
   * The single writer for the current binding. Every entry point goes through
   * here so it is audited and the owner gets a confirmation on QQ.
   */
  async function setBinding(nextId, source, actorId) {
    const previous = sessionId ? String(sessionId) : ''
    sessionId = nextId ? String(nextId) : undefined
    await saveState({ sessionId: sessionId || '' })
    await appendAudit({
      at: new Date().toISOString(),
      from: previous.slice(-8) || '(none)',
      to: sessionId ? sessionId.slice(-8) : '(none)',
      source,
      actor: actorId ? String(actorId) : '(unknown)',
    })
    const label = sessionId ? `…${sessionId.slice(-8)}` : '（未接通）'
    sendText(ownerUin, `已切换到 ${label}（来源：${source}）`).catch(() => {})
    return sessionId
  }

  /** Only the switchboard (Lily) may move the binding from an agent tool. */
  function mayRebind(exec) {
    const actor = String(exec?.agent?.id || '')
    if (!actor) return false
    // The switchboard always may.
    if (actor === String(lilySessionId || '')) return true
    // Whoever currently holds the call may hang itself up; without this a
    // forwarded session could never hand the phone back.
    return Boolean(sessionId) && actor === String(sessionId)
  }

  /**
   * Outbound pushes (text / files) are only open to the session currently on
   * the line. The binding is read from state.json on every call: an in-memory
   * copy goes stale as soon as a hangup or rebind happens, and a stale bridge
   * instance would otherwise keep forwarding files for a call that ended.
   */
  async function mayEmit(exec) {
    const actor = String(exec?.agent?.id || '')
    if (!actor) return false
    let bound = ''
    try {
      const saved = await loadState()
      bound = String(saved.sessionId || '')
    } catch {
      bound = ''
    }
    if (!bound) return false
    if (actor === bound) return true
    await recordError(
      'emit.denied',
      new Error(`actor=${actor.slice(-8)} bound=${bound.slice(-8)}`),
    )
    return false
  }

  const EMIT_DENIED =
    '这个会话没有接通 QQ，不能往外发东西。要发消息或文件，先把它接到 QQ 上（Lily 那边说「接 N」）。'

  /** Lily is replaced on every hangup, so she gets generational numbering. */
  function lilyTitle(generation) {
    return `controlV0.${generation}`
  }

  /** Keep the live switchboard's display name in sync with its generation. */
  async function ensureLilyTitle() {
    const saved = await loadState()
    const lily = lilySessionId || String(saved.lilySessionId || '')
    if (!lily) return

    // Someone archived the switchboard (sidebar cleanup, another agent). The
    // binding would then point at a dead session, so open the next one here.
    const archived = await archivedSessionIds()
    if (archived.has(String(lily))) {
      try {
        const gen = await nextLilyGeneration()
        const lilyCwd = `${cfg.workspacesRoot || DEFAULTS.workspacesRoot}\\${cfg.switchboardDir || DEFAULTS.switchboardDir}`
        const workspaceId = await ensureWorkspaceId(lilyCwd)
        const created = await ctx.sessionController.create(
          workspaceId ? { workspaceId } : { cwd: lilyCwd },
        )
        const fresh = String(created.sessionId)
        try {
          await ctx.sessionController.rename({ sessionId: fresh, title: lilyTitle(gen) })
        } catch {
          /* cosmetic */
        }
        lilySessionId = fresh
        sessionId = fresh
        await saveState({ lilyGeneration: gen, lilySessionId: fresh, sessionId: fresh })
        await appendAudit({
          at: new Date().toISOString(),
          from: String(lily).slice(-8),
          to: fresh.slice(-8),
          source: 'auto:switchboard-archived',
          actor: 'plugin',
        })
        log.warn?.(`qq: switchboard was archived; opened ${lilyTitle(gen)}`)
      } catch (error) {
        log.warn?.(
          `qq: failed to reopen switchboard: ${error instanceof Error ? error.message : String(error)}`,
        )
      }
      return
    }

    const want = lilyTitle(Number(saved.lilyGeneration) || 1)
    try {
      const { rows } = await sessionRows(false)
      const row = rows.find((r) => r.sessionId === String(lily))
      if (row && row.title !== want) {
        await ctx.sessionController.rename({ sessionId: lily, title: want })
        log.info?.(`qq: switchboard renamed to ${want}`)
      }
    } catch {
      /* renaming is cosmetic */
    }
  }

  async function nextLilyGeneration() {
    const saved = await loadState()
    return (Number(saved.lilyGeneration) || 0) + 1
  }

  const REBIND_DENIED =
    '这个会话无权改 QQ 绑定。只有 Lily 总机可以——在 QQ 上对 Lily 说「接 N」或「新 N」，或者在这里敲 /qq bind。'

  // ---------------------------------------------------------- NapCat API ---

  function apiUrl(action) {
    const base = cfg.napcatUrl.endsWith('/') ? cfg.napcatUrl : `${cfg.napcatUrl}/`
    return new URL(action, base).toString()
  }

  async function callApi(action, params, timeoutMs = 15_000) {
    const headers = {}
    if (cfg.accessToken) headers.authorization = `Bearer ${cfg.accessToken}`
    const { statusCode, body } = await postJson(apiUrl(action), params || {}, headers, timeoutMs)
    if (statusCode && statusCode >= 400) {
      throw new Error(`NapCat ${action}: HTTP ${statusCode} ${typeof body === 'string' ? body : ''}`.trim())
    }
    if (body && typeof body === 'object' && body.retcode !== 0 && body.retcode !== undefined) {
      const detail = body.message || body.wording || body.msg || ''
      throw new Error(`NapCat ${action}: retcode ${body.retcode} ${detail}`.trim())
    }
    return body && typeof body === 'object' ? body.data : undefined
  }

  /**
   * QQ shows raw text, so Markdown syntax just adds noise on the phone.
   * Strip the common markers while keeping the words and code content.
   */
  function plainText(md) {
    let s = String(md ?? '')
    // fenced code blocks: drop the fence, keep the body
    s = s.replace(/```[^\n]*\n([\s\S]*?)```/g, '$1')
    s = s.replace(/```/g, '')
    // inline code
    s = s.replace(/`([^`]+)`/g, '$1')
    // bold / italic
    s = s.replace(/\*\*([^*]+)\*\*/g, '$1')
    s = s.replace(/__([^_]+)__/g, '$1')
    s = s.replace(/(^|[\s(])\*([^*\n]+)\*(?=$|[\s).,，。])/g, '$1$2')
    // headings
    s = s.replace(/^#{1,6}\s+/gm, '')
    // links -> label (url) only when the label differs
    s = s.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1')
    // bullets
    s = s.replace(/^\s*[-*+]\s+/gm, '· ')
    // horizontal rules
    s = s.replace(/^\s*[-*_]{3,}\s*$/gm, '')
    return s.replace(/\n{3,}/g, '\n\n').trim()
  }

  async function sendText(uin, text) {
    const target = String(uin || ownerUin).trim()
    if (!target) throw new Error('qq: no target QQ number yet — send a message from the allowed account first')
    const chunks = splitText(plainText(text), maxChars)
    for (let i = 0; i < chunks.length; i += 1) {
      // Small gap between chunks: rapid-fire sends are what rate limits catch.
      if (i > 0) await sleep(350)
      await callApi('send_private_msg', { user_id: Number(target), message: chunks[i] })
    }
    return chunks.length
  }

  async function sendFile(uin, file, displayName) {
    const target = String(uin || ownerUin).trim()
    if (!target) throw new Error('qq: no target QQ number yet')
    const absolute = path.resolve(file)
    // The file leaves the machine, so keep credentials and session stores out
    // of reach even if some session is talked into sending them.
    const blocked =
      /(^|[\\/])(\.credentials\.yaml|id_rsa|id_ed25519|id_ecdsa|\.env(\.[^\\/]*)?|credentials\.json|cookies\.txt|passkey\.json)$/i.test(absolute) ||
      /[\\/]\.ssh[\\/]/i.test(absolute) ||
      /[\\/]\.dsh([\\/]sessions|[\\/]storages|[\\/]profiles)[\\/]/i.test(absolute)
    if (blocked) throw new Error('qq: 这个路径是凭据/会话数据，不给发。')
    // NB: never name this `stat` — it shadows the imported helper and the
    // initializer then hits the temporal dead zone ("Cannot access 'stat'
    // before initialization").
    const fileStat = await stat(absolute).catch(() => undefined)
    if (!fileStat || !fileStat.isFile()) throw new Error(`qq: 找不到文件：${absolute}`)
    const name = displayName || path.basename(absolute)
    const posix = absolute.replace(/\\/g, '/')
    // NapCat's Go-CQHTTP `upload_private_file` action returns
    // "rich media transfer failed" from the QQ 9.9.30 kernel no matter what
    // path form is used. The regular `send_private_msg` file segment goes
    // through a different code path inside NapCat and works on the same build,
    // so send the file as a message segment instead.
    try {
      await callApi('send_private_msg', {
        user_id: Number(target),
        message: [{ type: 'file', data: { file: posix, name } }],
      })
    } catch (error) {
      await callApi('send_private_msg', {
        user_id: Number(target),
        message: [{ type: 'file', data: { file: `file:///${posix}`, name } }],
      })
    }
    return absolute
  }

  async function sendImage(uin, file) {
    const target = String(uin || ownerUin).trim()
    if (!target) throw new Error('qq: no target QQ number yet')
    const absolute = path.resolve(file)
    const asUri = `file:///${absolute.replace(/\\/g, '/')}`
    await callApi('send_private_msg', {
      user_id: Number(target),
      message: [{ type: 'image', data: { file: asUri } }],
    })
    return absolute
  }

  /** Capture the primary screen into a PNG under the bridge data dir. */
  async function captureScreen() {
    await mkdir(cfg.dataDir, { recursive: true })
    const out = path.join(cfg.dataDir, `shot-${Date.now()}.png`)
    const ps = [
      'Add-Type -AssemblyName System.Windows.Forms',
      'Add-Type -AssemblyName System.Drawing',
      '$b=[System.Windows.Forms.Screen]::PrimaryScreen.Bounds',
      '$bmp=New-Object System.Drawing.Bitmap $b.Width,$b.Height',
      '$g=[System.Drawing.Graphics]::FromImage($bmp)',
      '$g.CopyFromScreen($b.Location,[System.Drawing.Point]::Empty,$b.Size)',
      `$bmp.Save('${out.replace(/\\/g, '\\\\')}',[System.Drawing.Imaging.ImageFormat]::Png)`,
      '$g.Dispose()',
      '$bmp.Dispose()',
    ].join('; ')
    await execFileP(
      'powershell',
      ['-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-Command', ps],
      { timeout: 25_000, windowsHide: true },
    )
    return out
  }

  /** Transcribe one QQ voice segment through the local whisper helper. */
  async function transcribeVoice(seg) {
    const fileRef = String(seg?.data?.file || '')
    const rawPath = String(seg?.data?.path || '')
    if (!fileRef && !rawPath) return ''
    // NapCat stores voice as silk/amr under its own cache. get_record decodes it,
    // but it only accepts the bare file name — a full path answers
    // "file not found" and the raw .amr then fails to decode as audio.
    let abs = ''
    if (fileRef) {
      try {
        const info = await callApi('get_record', { file: fileRef, out_format: 'wav' })
        const resolved = String(info?.file || info?.path || '')
        if (resolved) abs = resolved.startsWith('file://') ? resolved.slice(7) : resolved
      } catch (error) {
        log.warn(`qq: get_record failed: ${error instanceof Error ? error.message : String(error)}`)
      }
    }
    if (!abs) abs = rawPath || (path.isAbsolute(fileRef) ? fileRef : path.join(cfg.dataDir, fileRef))
    try {
      const { stdout } = await execFileP(
        cfg.pythonPath || 'python',
        [cfg.sttScript, abs, 'auto', cfg.sttModel || 'small'],
        {
          timeout: 180_000,
          windowsHide: true,
          env: {
            ...process.env,
            HF_ENDPOINT: 'https://hf-mirror.com',
            HF_HUB_DISABLE_XET: '1',
          },
        },
      )
      const line = String(stdout || '')
        .split(/\r?\n/)
        .filter((l) => l.trim().startsWith('{'))
        .pop()
      if (!line) return ''
      const parsed = JSON.parse(line)
      if (parsed.error) {
        log.warn(`qq: stt failed: ${parsed.error}`)
        await recordError('stt', parsed.error)
        return ''
      }
      return String(parsed.text || '').trim()
    } catch (error) {
      log.warn(`qq: stt error: ${error instanceof Error ? error.message : String(error)}`)
      await recordError('stt', error)
      return ''
    }
  }

  /**
   * Turn one OneBot image segment into a DSH image content part.
   * NapCat keeps the file locally; get_image resolves the segment to a path.
   */
  async function imagePart(seg) {
    const raw = String(seg?.data?.file || seg?.data?.url || seg?.data?.path || '')
    if (!raw) return undefined
    let filePath = ''
    try {
      const info = await callApi('get_image', { file: raw })
      filePath = String(info?.file || info?.path || '')
    } catch (error) {
      log.warn(`qq: get_image failed: ${error instanceof Error ? error.message : String(error)}`)
    }
    if (!filePath) return undefined
    if (filePath.startsWith('file://')) filePath = filePath.slice(7)
    filePath = path.normalize(filePath)
    const buffer = await readFile(filePath)
    if (!buffer.length) return undefined
    // 按文件头判断真实类型：iPhone 发来的图常是 .png 扩展名但内容是 JPEG，
    // 按扩展名声明会让宿主报 "Declared image type does not match its bytes"。
    let mediaType = 'image/jpeg'
    if (buffer.length >= 12 &&
        buffer[0] === 0x89 && buffer[1] === 0x50 && buffer[2] === 0x4e && buffer[3] === 0x47) {
      mediaType = 'image/png'
    } else if (buffer.length >= 6 &&
        buffer[0] === 0x47 && buffer[1] === 0x49 && buffer[2] === 0x46) {
      mediaType = 'image/gif'
    } else if (buffer.length >= 12 &&
        buffer.toString('ascii', 8, 12) === 'WEBP') {
      mediaType = 'image/webp'
    } else if (buffer.length >= 2 && buffer[0] === 0xff && buffer[1] === 0xd8) {
      mediaType = 'image/jpeg'
    }
    // Keep the cache small: phone photos are a few MB each.
    if (buffer.length > 12 * 1024 * 1024) {
      log.warn(`qq: image too large (${buffer.length} bytes), skipped`)
      return undefined
    }
    return {
      type: 'image',
      mediaType,
      data: buffer.toString('base64'),
      name: path.basename(filePath),
    }
  }

  // ------------------------------------------------------------- session ---

  /** Persist the last failure so it is readable without attaching a debugger. */
  async function recordError(stage, error) {
    try {
      await mkdir(cfg.dataDir, { recursive: true })
      await writeFile(
        path.join(cfg.dataDir, 'last-error.txt'),
        `${new Date().toISOString()} [${stage}]\n${error?.stack || String(error)}\n`,
        'utf8',
      )
    } catch {
      /* diagnostics only */
    }
  }

  async function ensureSession() {
    if (sessionId) return sessionId
    const saved = await loadState()
    if (saved.ownerUin) ownerUin = String(saved.ownerUin)
    if (saved.lilySessionId) lilySessionId = String(saved.lilySessionId)

    // Try the stored binding first, then the switchboard. A session id from a
    // previous DSH process no longer exists, so falling back keeps the bridge
    // answering instead of erroring on every message.
    const ordered = [saved.sessionId, saved.lilySessionId]
      .map((v) => (v ? String(v) : ''))
      .filter((v, i, arr) => v && arr.indexOf(v) === i)
    for (const candidate of ordered) {
      try {
        const inspection = await ctx.sessionController.inspect(candidate)
        if (inspection?.meta?.id) {
          sessionId = candidate
          if (candidate !== String(saved.sessionId || '')) {
            log.warn(`qq: stored binding ${String(saved.sessionId || '').slice(-8)} is gone; using ${candidate.slice(-8)}`)
            await saveState({ sessionId: candidate })
            await appendAudit({
              at: new Date().toISOString(),
              from: String(saved.sessionId || '').slice(-8) || '(none)',
              to: candidate.slice(-8),
              source: 'auto:binding-missing',
              actor: 'plugin',
            })
          }
          return sessionId
        }
      } catch {
        /* try the next candidate */
      }
    }
    throw new Error('还没有接线：在会话里 /qq bind，或者新建一个总机')
  }

  /** Whether the target session currently has a turn in flight. */
  async function isSessionBusy(sid) {
    try {
      const controller = new AbortController()
      const listed = await ctx.sessionController.list({}, controller.signal)
      const row = (Array.isArray(listed?.items) ? listed.items : []).find(
        (s) => String(s.sessionId) === String(sid),
      )
      return Boolean(row?.running)
    } catch {
      return false
    }
  }

  async function promptSession(text, options = {}) {
    // 桥可能被实例化多份：收消息那份内存里的绑定可能已经过时（内存里还认旧会话，
    // 却看不到 qq_bind_session 改过的 state.json）。投递前一律以记事本为准。
    const persisted = await loadState()
    const onDisk = persisted && persisted.sessionId ? String(persisted.sessionId) : ''
    if (onDisk && onDisk !== String(sessionId || '')) {
      sessionId = onDisk
      log.info?.(`qq: adopted persisted binding ${sessionId}`)
    }
    let sid = await ensureSession()
    // The bound session may have been archived or deleted since the last
    // message. Delivering there would end the turn as `blocked` with no reply,
    // so hand the chat back to the switchboard instead.
    if (!(await sessionUsable(sid))) {
      const fellBack = await rebindToSwitchboard(sid, 'auto:binding-unusable')
      if (fellBack) {
        sid = fellBack
        if (options.quiet !== true) {
          sendText(
            ownerUin,
            '原来接的那个会话不在了（被删或归档），已经转回总控。',
          ).catch(() => {})
        }
      }
    }
    const busy = await isSessionBusy(sid)
    // A busy session would swallow the message until its turn ends. Say so
    // immediately instead of leaving the owner staring at a silent chat.
    if (busy && options.quiet !== true) {
      sendText(ownerUin, '收到，这边手头那轮还没跑完，消息排着了，跑完就回你。').catch(() => {})
    }
    // Hangup-style instructions jump the queue: waiting behind a long turn
    // would make them useless.
    const mode = busy && options.steer === true ? 'steer' : 'queue'
    const controller = new AbortController()
    // Text and images ride in one prompt: DSH accepts image parts with base64
    // data, so a photo from the phone reaches the session as a real image.
    const content = []
    if (String(text || '').trim()) content.push({ type: 'text', text })
    for (const part of Array.isArray(options.parts) ? options.parts : []) content.push(part)
    if (content.length === 0) content.push({ type: 'text', text: '（空消息）' })
    try {
      await ctx.sessionController.prompt(
        {
          requestId: `qq-${Date.now()}-${randomUUID().slice(0, 8)}`,
          sessionId: sid,
          mode,
          content,
        },
        controller.signal,
      )
    } catch (error) {
      await recordError('session.prompt', error)
      throw error
    }
  }

  /** One canonical, phone-friendly session list shared by the QQ tools. */
  async function sessionRows(includeNoise = false) {
    const controller = new AbortController()
    const [listed, archived] = await Promise.all([
      ctx.sessionController.list({}, controller.signal),
      archivedSessionIds(),
    ])
    const all = Array.isArray(listed?.items) ? listed.items : []
    const titleOf = (s) => String(s?.projections?.values?.title || '')
    const kept = includeNoise
      ? all
      : all.filter((s) => {
          const id = String(s.sessionId)
          // The bound switchboard must never be hidden, even while its title
          // is still settling right after creation.
          if (sessionId && id === String(sessionId)) return true
          if (archived.has(id)) return false
          if (s?.blank) return false
          const t = titleOf(s)
          if (/^\[dsh-mnemon/i.test(t)) return false
          if (/^[0-9a-f]{6,12}$/i.test(t)) return false
          if (!t && !s?.running) return false
          return true
        })
    const rows = kept.map((s) => {
      const values = s?.projections?.values || {}
      return {
        sessionId: String(s.sessionId),
        short: String(s.sessionId).slice(-8),
        title: String(values.title || ''),
        cwd: s.cwd ? String(s.cwd) : '',
        running: Boolean(s.running),
        updatedAt: s.updatedAt ? new Date(s.updatedAt).toISOString() : '',
        bound: sessionId ? String(s.sessionId) === String(sessionId) : false,
        // Raw projections: goal / plan / agentTeam / subagent survive a Host
        // restart, so the activity snapshot still has something to say about a
        // session that has emitted no event since this plugin mounted.
        values,
      }
    })
    return { rows, hiddenNoise: all.length - kept.length }
  }

  /** Session ids the user archived; those must not show up in the QQ list. */
  async function archivedSessionIds() {
    try {
      const file = path.join(os.homedir(), '.dsh', 'storages', 'workspace.json')
      const raw = await readFile(file, 'utf8')
      const parsed = JSON.parse(raw)
      const ids = parsed?.global?.archivedSessionIds
      return new Set(Array.isArray(ids) ? ids.map(String) : [])
    } catch {
      return new Set()
    }
  }

  /**
   * Whether a session can still take a turn: it exists and the user has not
   * archived it. An archived session is not "gone" — `inspect` still answers —
   * but DSH's archived-session gate ends every turn as `blocked` before a model
   * request, so a message delivered there is silently swallowed.
   */
  async function sessionUsable(sid) {
    const id = String(sid || '')
    if (!id) return false
    const archived = await archivedSessionIds()
    if (archived.has(id)) return false
    try {
      const inspection = await ctx.sessionController.inspect(id)
      if (inspection?.meta?.id) return true
    } catch {
      /* fall through to the session list */
    }
    // `inspect` can fail transiently while the session is busy; the registry
    // list is the second opinion, so a hiccup never silently moves the chat.
    try {
      const controller = new AbortController()
      const listed = await ctx.sessionController.list({}, controller.signal)
      const rows = Array.isArray(listed?.items) ? listed.items : []
      return rows.some((s) => String(s.sessionId) === id)
    } catch {
      return false
    }
  }

  /** Open the next switchboard generation when the current one is gone. */
  async function openFreshSwitchboard() {
    const gen = await nextLilyGeneration()
    const lilyCwd = `${cfg.workspacesRoot || DEFAULTS.workspacesRoot}\\${cfg.switchboardDir || DEFAULTS.switchboardDir}`
    const workspaceId = await ensureWorkspaceId(lilyCwd)
    const created = await ctx.sessionController.create(
      workspaceId ? { workspaceId } : { cwd: lilyCwd },
    )
    const fresh = String(created.sessionId)
    try {
      await ctx.sessionController.rename({ sessionId: fresh, title: lilyTitle(gen) })
    } catch {
      /* cosmetic */
    }
    lilySessionId = fresh
    sessionId = fresh
    await saveState({ lilyGeneration: gen, lilySessionId: fresh, sessionId: fresh })
    log.warn?.(`qq: opened ${lilyTitle(gen)} as the new switchboard`)
    return fresh
  }

  /**
   * Move the binding back to the switchboard when the bound session can no
   * longer answer (deleted or archived), instead of posting into a black hole.
   * @returns the session id now bound, or '' when no switchboard could be found.
   */
  async function rebindToSwitchboard(fromId, source) {
    try {
      const saved = await loadState()
      let lily = String(lilySessionId || saved.lilySessionId || '')
      if (lily && !(await sessionUsable(lily))) lily = ''
      if (!lily) lily = await openFreshSwitchboard()
      if (!lily) return ''
      sessionId = lily
      await saveState({ sessionId: lily })
      await appendAudit({
        at: new Date().toISOString(),
        from: String(fromId || '').slice(-8) || '(none)',
        to: lily.slice(-8),
        source,
        actor: 'plugin',
      })
      log.warn?.(
        `qq: bound session ${String(fromId || '').slice(-8)} cannot take turns; rebound to switchboard ${lily.slice(-8)}`,
      )
      return lily
    } catch (error) {
      log.warn?.(
        `qq: switchboard fallback failed: ${error instanceof Error ? error.message : String(error)}`,
      )
      return ''
    }
  }

  /** Agent workspaces on this machine, ordered so a number stays stable per call. */
  async function listWorkspaces() {
    const root = cfg.workspacesRoot || DEFAULTS.workspacesRoot
    let entries = []
    try {
      entries = await readdir(root, { withFileTypes: true })
    } catch (error) {
      log.warn(`qq: cannot read ${root}: ${error instanceof Error ? error.message : String(error)}`)
      return []
    }
    return entries
      .filter((e) => e.isDirectory() && !e.name.startsWith('.') && !e.name.startsWith('_'))
      .map((e) => e.name)
      .sort((a, b) => a.localeCompare(b, 'en'))
  }

  /** Register (or find) a DSH workspace for one directory, so sessions are grouped. */
  async function ensureWorkspaceId(cwd) {
    const registry = ctx.get('workspaceRegistry')
    if (!registry) return undefined
    try {
      const existing = await registry.resolveByPath(cwd)
      if (existing?.id) return String(existing.id)
      const created = await registry.create(cwd)
      return created?.id ? String(created.id) : undefined
    } catch (error) {
      log.warn(
        `qq: workspace resolve failed for ${cwd}: ${error instanceof Error ? error.message : String(error)}`,
      )
      return undefined
    }
  }

  /**
   * Hang up and open a fresh switchboard. Shared by the qq_hangup tool and the
   * keyword path in handleEvent, so "挂了" works no matter who is on the line.
   */
  async function hangupToSwitchboard(source) {
    const saved = await loadState()
    const oldLily = lilySessionId || String(saved.lilySessionId || '')
    const lilyCwd = `${cfg.workspacesRoot || DEFAULTS.workspacesRoot}\\${cfg.switchboardDir || DEFAULTS.switchboardDir}`
    try {
      const workspaceId = await ensureWorkspaceId(lilyCwd)
      const created = await ctx.sessionController.create(
        workspaceId ? { workspaceId } : { cwd: lilyCwd },
      )
      const fresh = String(created.sessionId)
      const gen = await nextLilyGeneration()
      try {
        await ctx.sessionController.rename({ sessionId: fresh, title: lilyTitle(gen) })
      } catch {
        /* cosmetic */
      }
      await saveState({ lilyGeneration: gen })
      lilySessionId = fresh
      await saveState({ lilySessionId: fresh })
      await setBinding(fresh, source, 'plugin')
      if (oldLily && oldLily !== fresh) {
        const registry = ctx.get('workspaceRegistry')
        try {
          await registry?.archiveSession(oldLily)
        } catch {
          /* archiving the old switchboard is best-effort */
        }
      }
      return fresh
    } catch (error) {
      await recordError('hangup.create', error)
      // Fall back to the existing switchboard rather than leaving QQ unbound.
      if (oldLily) {
        await setBinding(oldLily, `${source}(fallback)`, 'plugin')
        return oldLily
      }
      throw error
    }
  }

  // --------------------------------------------------------------- groups ---

  const groupCfg = { ...DEFAULTS.group, ...(cfg.group || {}) }
  const groupCloud = { ...DEFAULTS.group.cloud, ...(groupCfg.cloud || {}) }
  const groupCloudKeyFile = String(
    groupCloud.keyFile || path.join(cfg.dataDir || DEFAULTS.dataDir, 'cloud-key.txt'),
  )
  let groupCloudKey = ''
  let groupCloudKeyLoaded = false

  /** Cloud models ride on an API key file, not on DSH's account login. */
  async function cloudApiKey() {
    if (groupCloudKeyLoaded) return groupCloudKey
    groupCloudKeyLoaded = true
    try {
      groupCloudKey = (await readFile(groupCloudKeyFile, 'utf8')).trim()
    } catch {
      groupCloudKey = ''
    }
    return groupCloudKey
  }

  function isCloudModel(value) {
    return String(value || '').startsWith('cloud:')
  }
  const groupAllowed = new Set(
    (groupCfg.allowGroups || []).map((v) => String(v).trim()).filter(Boolean),
  )
  const groupHistory = new Map()
  const groupStamps = new Map()
  const groupLastReply = new Map()
  const groupMemory = new Map()
  const groupExchange = new Map()
  let groupMemoryLoaded = false
  let groupMemoryTimer

  const groupMemoryFile = String(
    groupCfg.memoryFile || path.join(cfg.dataDir || DEFAULTS.dataDir, 'group-memory.json'),
  )
  const groupSettingsFile = path.join(
    cfg.dataDir || DEFAULTS.dataDir,
    'group-settings.json',
  )
  let groupSettingsLoaded = false
  let groupModelOverride = ''
  // undefined = follow the config; true/false = owner's runtime choice.
  let groupRequireMention

  /** The group picks its own local model; it is not the private session's. */
  function effectiveGroupModel() {
    return groupModelOverride || groupCfg.model
  }

  /** Does the bot need an @ (or wake word) before it answers in a group? */
  function needsMention() {
    if (typeof groupRequireMention === 'boolean') return groupRequireMention
    return groupCfg.requireMention !== false
  }

  async function loadGroupSettings() {
    if (groupSettingsLoaded) return
    groupSettingsLoaded = true
    try {
      const parsed = JSON.parse(await readFile(groupSettingsFile, 'utf8'))
      if (typeof parsed?.model === 'string') groupModelOverride = parsed.model.trim()
      if (typeof parsed?.requireMention === 'boolean') groupRequireMention = parsed.requireMention
    } catch {
      /* no override yet */
    }
  }

  async function saveGroupSettings() {
    try {
      await mkdir(path.dirname(groupSettingsFile), { recursive: true })
      const payload = { model: groupModelOverride }
      if (typeof groupRequireMention === 'boolean') payload.requireMention = groupRequireMention
      await writeFile(groupSettingsFile, `${JSON.stringify(payload, null, 2)}\n`, 'utf8')
    } catch (error) {
      log.warn?.(`qq: [群] 设置写盘失败：${error instanceof Error ? error.message : String(error)}`)
    }
  }

  /** Ask LM Studio which models it currently serves (chat ones only). */
  async function groupModelOptions() {
    const base = String(groupCfg.baseUrl || DEFAULTS.group.baseUrl).replace(/\/+$/, '')
    const res = await getJson(`${base}/models`, 8000)
    const list = Array.isArray(res?.body?.data) ? res.body.data : []
    const local = list
      .map((entry) => String(entry?.id ?? ''))
      .filter((id) => id && !/embed/i.test(id))
      .map((id) => ({ value: id, label: id }))
    const cloud = []
    if (groupCloud.enabled && (await cloudApiKey())) {
      for (const id of groupCloud.models || []) {
        const model = String(id || '').trim()
        if (model) cloud.push({ value: `cloud:${model}`, label: `${model}（云）` })
      }
    }
    return [...local, ...cloud]
  }

  function modelLabel(value) {
    return isCloudModel(value) ? `${String(value).slice(6)}（云）` : String(value)
  }

  async function groupModelCommandReply(argument) {
    const arg = String(argument || '').trim()
    const options = await groupModelOptions().catch(() => [])
    const current = effectiveGroupModel()
    if (!arg) {
      const lines = options.map(
        (item, index) =>
          `${index + 1}. ${item.label}${item.value === current ? '  ← 当前' : ''}`,
      )
      const head = options.length ? lines.join('\n') : '（没拿到模型列表）'
      return [
        '群聊可用的模型：',
        head,
        '',
        `现在：${modelLabel(current)}`,
        '发「/群模型 2」切换，「/群模型 恢复」回配置默认（本地 qwen4b）。',
        '注：只影响群聊；私聊会话用 /模型。云端按 token 计费。',
      ].join('\n')
    }
    if (/^(恢复|默认|reset|default)$/i.test(arg)) {
      groupModelOverride = ''
      await saveGroupSettings()
      return `群聊模型已回到配置默认：${groupCfg.model}`
    }
    let target
    const index = Number(arg)
    if (Number.isInteger(index) && index >= 1 && index <= options.length) target = options[index - 1]
    if (!target) {
      const needle = arg.toLowerCase()
      target = options.find(
        (item) =>
          item.label.toLowerCase().includes(needle) || item.value.toLowerCase().includes(needle),
      )
    }
    if (!target) return `没找到「${arg}」。发「/群模型」看列表。`
    groupModelOverride = target.value
    await saveGroupSettings()
    return `群聊已切到 ${target.label}。${isCloudModel(target.value) ? '（云端，按 token 计费）' : ''}`
  }

  /**
   * Runtime switch for "must I be @'d in a group". Persisted next to the model
   * override, so it survives restarts without editing the profile config.
   */
  async function groupReplyCommandReply(argument) {
    const arg = String(argument || '').trim().toLowerCase()
    const open = ['开', 'on', '全部', 'always', 'all', '不用@', '不用']
    const close = ['关', 'off', '只@', '@', 'mention', '要@']
    if (open.includes(arg)) groupRequireMention = false
    else if (close.includes(arg)) groupRequireMention = true
    else groupRequireMention = !needsMention()
    await saveGroupSettings()
    return needsMention()
      ? '群聊恢复成只回 @ 和唤醒词。'
      : '群聊现在每条都回，不用 @。嫌吵发「/群回复 关」。'
  }

  /** Small model, small memory: a compact per-group summary is persisted. */
  async function loadGroupMemory() {
    if (groupMemoryLoaded) return
    groupMemoryLoaded = true
    try {
      const parsed = JSON.parse(await readFile(groupMemoryFile, 'utf8'))
      for (const [key, value] of Object.entries(parsed || {})) {
        if (value && typeof value.summary === 'string' && value.summary.trim()) {
          groupMemory.set(key, { summary: value.summary, updatedAt: Number(value.updatedAt) || 0 })
        }
      }
    } catch {
      /* first run: start empty */
    }
  }

  function saveGroupMemorySoon() {
    clearTimeout(groupMemoryTimer)
    groupMemoryTimer = setTimeout(async () => {
      try {
        const out = {}
        for (const [key, value] of groupMemory) out[key] = value
        await mkdir(path.dirname(groupMemoryFile), { recursive: true })
        await writeFile(groupMemoryFile, `${JSON.stringify(out, null, 2)}\n`, 'utf8')
      } catch (error) {
        log.warn?.(`qq: [群] 记忆写盘失败：${error instanceof Error ? error.message : String(error)}`)
      }
    }, 1500)
    groupMemoryTimer.unref?.()
  }

  /**
   * One chat completion. Local models go to LM Studio; "cloud:<model>" entries
   * go to the OpenAI-compatible cloud endpoint with the stored API key.
   */
  async function askGroupModel(messages, options = {}) {
    const picked = effectiveGroupModel()
    const cloudModel = isCloudModel(picked) ? String(picked).slice(6) : ''
    const base = cloudModel
      ? String(groupCloud.baseUrl || DEFAULTS.group.cloud.baseUrl).replace(/\/+$/, '')
      : String(groupCfg.baseUrl || DEFAULTS.group.baseUrl).replace(/\/+$/, '')
    const headers = {}
    if (cloudModel) {
      const key = await cloudApiKey()
      if (!key) throw new Error('云端模型没有 API key（cloud-key.txt 是空的）')
      headers.authorization = `Bearer ${key}`
    }
    const localBudget =
      Number(options.maxTokens) || Number(groupCfg.maxTokens) || DEFAULTS.group.maxTokens
    // Reasoning models spend the budget thinking first; give cloud calls room
    // and retry once with a much larger cap if the answer got cut off.
    const budgets = cloudModel
      ? [Math.max(localBudget, Number(groupCloud.maxTokens) || DEFAULTS.group.cloud.maxTokens)]
      : [localBudget]
    if (cloudModel) budgets.push(budgets[0] * 4)
    const timeoutMs = cloudModel
      ? Number(groupCloud.timeoutMs) || DEFAULTS.group.cloud.timeoutMs
      : Number(groupCfg.timeoutMs) || DEFAULTS.group.timeoutMs

    let lastPayload
    let lastStatus
    for (const maxTokens of budgets) {
      const body = {
        model: cloudModel || picked,
        messages,
        temperature:
          Number(options.temperature) || Number(groupCfg.temperature) || DEFAULTS.group.temperature,
        max_tokens: maxTokens,
        stream: false,
        ...(cloudModel && groupCloud.disableThinking !== false
          ? { thinking: { type: 'disabled' } }
          : {}),
      }
      const res = await postJson(`${base}/chat/completions`, body, headers, timeoutMs)
      // postJson resolves { statusCode, body } — the completion lives in .body.
      const payload = res?.body
      lastPayload = payload
      lastStatus = res?.statusCode
      if (res?.statusCode && res.statusCode >= 400) {
        throw new Error(`HTTP ${res.statusCode} ${JSON.stringify(payload).slice(0, 120)}`)
      }
      const text = payload?.choices?.[0]?.message?.content
      if (typeof text === 'string' && text.trim()) return text.trim()
      log.warn?.(
        `qq: [群] 空回复（max_tokens=${maxTokens}，finish=${payload?.choices?.[0]?.finish_reason ?? '?'}）`,
      )
    }
    const sample =
      typeof lastPayload === 'string'
        ? lastPayload.slice(0, 120)
        : JSON.stringify(lastPayload ?? null).slice(0, 120)
    throw new Error(`empty completion (status=${lastStatus ?? '?'}, body=${sample})`)
  }

